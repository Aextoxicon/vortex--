# Vortex Docker Compose 环境配置
# 复制为 .env 后使用: docker compose up -d

# ==================== 必须修改 ====================

# JWT 密钥（必须生成 - 运行: openssl rand -base64 32）
JWT_SECRET=

# ==================== 以下配置通常无需修改 ====================
# 如需自定义，取消注释并修改值

# NODE_ID=0
# PORT=:9178
# DATABASE_URL=postgres://vortex:vortex_password@postgres:5432/vortex?sslmode=disable
# JWT_ISSUER=vortex
# JWT_EXPIRES_MINUTES=10080
# DB_MAX_OPEN_CONNS=50
# DB_MAX_IDLE_CONNS=20
# BCRYPT_COST=10
# MESSAGE_RECALL_WINDOW_MS=120000
# MESSAGE_RETENTION_DAYS=7
# EPOCH_TIME=1767225600000
# ID_SEGMENT_DURATION_MS=10000
# ID_SEGMENT_SIZE=131072
# DEFAULT_PAGE_SIZE=100
# MAX_PAGE_SIZE=500
# PUBLIC_ID_LENGTH=21
# GROUP_ID_RANDOM_LENGTH=8
# WORKER_TABLE_CREATE_INTERVAL_HOURS=168
# WORKER_MAINTENANCE_INITIAL_DELAY_MINUTES=5
# WORKER_MAINTENANCE_INTERVAL_HOURS=24
# S3_URL=s3://vortex-files?endpoint=http://seaweedfs-s3:8333&region=us-east-1&access_key=any&secret_key=any
# IDEMPOTENCY_RETENTION_HOURS=24
