# Cross-compiled Docker image
# Uses pre-built binaries from GitHub Actions — no Go toolchain needed.
FROM alpine:3.21

ARG TARGETARCH

RUN apk add --no-cache ca-certificates libpq \
    && addgroup -S vortex && adduser -S vortex -G vortex

WORKDIR /app

# Both binaries are prepared in the build context by the CI workflow
COPY docker-bin/ /tmp/bin/

# Pick the right binary for the target architecture
RUN if [ "$TARGETARCH" = "amd64" ]; then \
      cp /tmp/bin/vortex-amd64 /app/vortex; \
    else \
      cp /tmp/bin/vortex-arm64 /app/vortex; \
    fi && \
    chmod +x /app/vortex && \
    rm -rf /tmp/bin

RUN chown -R vortex:vortex /app

USER vortex

EXPOSE 9178

ENTRYPOINT ["/app/vortex"]
