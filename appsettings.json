{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Type": "sqlite",
    "ConnectionString": "Data Source=vortex.db",
    "DefaultConnection": "Data Source=vortex.db",
    "PostgresConnection": "Host=localhost;Database=vortex;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "SecretKey": "your-super-secret-jwt-key-at-least-32-characters-long",
    "Issuer": "vortex",
    "Audience": "vortex",
    "ExpiresInMinutes": 10080,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true
  },
  "S3": {
    "Enabled": false,
    "Bucket": "",
    "Region": "us-east-1",
    "PresignExpiresIn": 3600,
    "AccessKeyId": "",
    "SecretAccessKey": ""
  },
  "DeviceLimit": 3,
  "NodeId": 0,
  "Outbox": {
    "MaxRetryCount": 3,
    "MaxRetryIntervalSeconds": 3600
  },
  "Features": {
    "EnableOutbox": true,
    "EnableDatabaseMaintenance": true,
    "EnableMessageTableManager": true,
    "EnableWalCheckpoint": true,
    "EnableVacuum": true,
    "EnableDataPurge": true
  },
  "Maintenance": {
    "WalCheckpointIntervalMinutes": 60,
    "VacuumIntervalHours": 24,
    "DataPurgeDays": 7,
    "MessageTablePreCreateDays": 7
  },
  "Security": {
    "PasswordHashCost": 12,
    "NanoIdSize": 21,
    "EnableRateLimiting": true,
    "MaxLoginAttemptsPerMinute": 5
  },
  "Cache": {
    "Enabled": false,
    "Type": "memory",
    "RedisConnection": "",
    "DefaultExpirationMinutes": 30
  },
  "Cors": {
    "Enabled": false,
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },
  "HealthCheck": {
    "Enabled": true,
    "Path": "/health"
  }
}
