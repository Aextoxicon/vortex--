# Server
NODE_ID=0
PORT=:8080

# Database
DATABASE_URL=postgres://localhost:5432/vortex?sslmode=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=20

# JWT (Required - generate with: openssl rand -base64 32)
JWT_SECRET=
JWT_ISSUER=vortex
JWT_EXPIRES_MINUTES=10080

# Security
BCRYPT_COST=10

# Messages
MESSAGE_RECALL_WINDOW_MS=120000
MESSAGE_RETENTION_DAYS=7

# ID Generator
EPOCH_TIME=1767225600000
ID_SEGMENT_DURATION_MS=10000
ID_SEGMENT_SIZE=131072

# Pagination
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=500

# Public ID
PUBLIC_ID_LENGTH=21
GROUP_ID_RANDOM_LENGTH=8

# Worker
WORKER_TABLE_CREATE_INTERVAL_HOURS=168
WORKER_MAINTENANCE_INITIAL_DELAY_MINUTES=5
WORKER_MAINTENANCE_INTERVAL_HOURS=24
