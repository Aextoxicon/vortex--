# ==================== 必要配置 ====================

# 节点 ID (0-31)
NODE_ID=0

# 服务端口
PORT=:8080

# 数据库连接（必须修改）
DATABASE_URL=postgres://localhost:5432/vortex?sslmode=disable

# JWT 密钥（必须生成 - 运行 openssl rand -base64 32）
JWT_SECRET=

# ==================== 可选配置 ====================
# 以下配置有合理默认值，仅在需要自定义时取消注释

# JWT 配置
# JWT_ISSUER=vortex
# JWT_EXPIRES_MINUTES=10080

# 数据库连接池
# DB_MAX_OPEN_CONNS=50
# DB_MAX_IDLE_CONNS=20

# 安全配置
# BCRYPT_COST=10

# 消息配置
# MESSAGE_RECALL_WINDOW_MS=120000
# MESSAGE_RETENTION_DAYS=7

# ID 生成器配置
# EPOCH_TIME=1767225600000
# ID_SEGMENT_DURATION_MS=10000
# ID_SEGMENT_SIZE=131072

# 分页配置
# DEFAULT_PAGE_SIZE=100
# MAX_PAGE_SIZE=500

# ID 长度配置
# PUBLIC_ID_LENGTH=21
# GROUP_ID_RANDOM_LENGTH=8

# Worker 配置
# WORKER_TABLE_CREATE_INTERVAL_HOURS=168
# WORKER_MAINTENANCE_INITIAL_DELAY_MINUTES=5
# WORKER_MAINTENANCE_INTERVAL_HOURS=24

# ==================== S3 文件存储配置 ====================
# 可选配置，为空则不启用文件存储功能
# 支持 AWS S3 及兼容 S3 协议的服务（如 MinIO、LocalStack）

# S3 Bucket 名称（必填，启用文件存储时设置）
# S3_BUCKET=your-bucket-name

# S3 区域（默认: us-east-1）
# S3_REGION=us-east-1

# S3 端点（可选，使用 MinIO 等自建服务时设置，如 http://localhost:9000）
# S3_ENDPOINT=

# S3 访问密钥（可选，使用 IAM 角色或本地模拟服务时可为空）
# S3_ACCESS_KEY=

# S3 密钥（可选，使用 IAM 角色或本地模拟服务时可为空）
# S3_SECRET_KEY=
