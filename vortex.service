[Unit]
Description=Vortex is backend of collision
Documentation=https://github.com/aextoxicon/vortex--
After=network.target

[Service]
Type=simple
User=vortex
Group=vortex
WorkingDirectory=/opt/vortex

EnvironmentFile=/etc/vortex/.env

ExecStart=/opt/vortex/vortex
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed

Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

LimitNOFILE=65536
LimitNPROC=4096

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/tmp /opt/vortex
PrivateTmp=true

StandardOutput=journal

[Install]
WantedBy=multi-user.target