[Unit]
Description=Vortex is backend of collision
Documentation=https://github.com/aextoxicon/vortex--
After=network.target

[Service]
Type=simple
User=vortex
Group=vortex
WorkingDirectory=/opt/vortex

EnvironmentFile=/etc/vortex/.env

ExecStart=/opt/vortex/vortex
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

TimeoutStartSec=30
TimeoutStopSec=30
KillSignal=SIGINT
KillMode=mixed

LimitNOFILE=65536
LimitNPROC=4096

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vortex

[Install]
WantedBy=multi-user.target